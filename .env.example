# GitHub token for the GraphQL API (required). Free: github.com/settings/tokens/new
# with NO scopes ticked; it can only read public data.
GITHUB_TOKEN=

# Upstash Redis (free) for page views, edition numbers and a 12 h cache.
# Vercel → Storage → Upstash for Redis → connect adds these. Without them the app
# keeps everything in memory (fine for local dev) and hides page views in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: the public host shown in share pictures (defaults to the Vercel domain)
NEXT_PUBLIC_SITE_HOST=
